@echo off
chcp 65001 > nul
REM 展示監控模式的詳細日誌功能

echo ╔════════════════════════════════════════════════════════════╗
echo ║     FTPS Downloader - 監控模式日誌展示                    ║
echo ╚════════════════════════════════════════════════════════════╝
echo.
echo 【功能說明】
echo.
echo 此程式在監控模式下，每次檢查都會顯示詳細狀態：
echo.
echo ✓ 檢查時間 - 精確到秒
echo ✓ 停止時間狀態 - 是否接近停止時間
echo ✓ 時間範圍檢查 - 是否在下載時間內
echo ✓ 執行狀態 - 下載中或待機中
echo ✓ 下次檢查時間 - 預計下次執行時間
echo.
echo 【重要特色】
echo.
echo 💡 即使不在下載時間內，也會每分鐘顯示狀態
echo 💡 所有信息都會記錄到 log 檔案
echo 💡 方便追蹤程式運行狀況
echo 💡 清楚知道程式是否正常工作
echo.
echo ────────────────────────────────────────────────────────────
echo.
echo 現在將啟動測試模式：
echo - 每 1 分鐘檢查一次（快速展示）
echo - 不設定時間範圍（任何時間都可下載）
echo - 運行 5 分鐘後您可以按 Ctrl+C 停止
echo.
echo 請注意觀察控制台和 logs 目錄中的日誌檔案
echo.
echo ────────────────────────────────────────────────────────────
echo.
echo 按任意鍵開始，或按 Ctrl+C 取消...
pause > nul
echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║     開始監控模式 - 請觀察下方的詳細日誌輸出              ║
echo ╚════════════════════════════════════════════════════════════╝
echo.

REM 啟動監控模式（使用實際可用的參數）
ftps-downloader.exe ^
  -monitor-mode ^
  -check-interval 1 ^
  -local-dir ./downloads ^
  -log-dir ./logs ^
  -config config.properties

echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║     測試結束                                               ║
echo ╚════════════════════════════════════════════════════════════╝
echo.
echo 請查看 logs 目錄中的日誌檔案：
dir /b logs\ftps-downloader-*.log 2>nul
echo.
pause
