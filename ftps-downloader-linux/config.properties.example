# ================================================================
# FTPS Downloader 標準設定檔
# ================================================================

# ================================================================
# 基本連線設定
# ================================================================
# FTPS 伺服器位址
host=127.0.0.1

# 連接埠 (21=Explicit TLS, 990=Implicit TLS)
port=21

# 登入帳號
user=username

# 登入密碼
pass=password

# ================================================================
# 目錄設定
# ================================================================
# 遠端起始目錄 (選填)
remote_dir=

# 本地下載目錄
local_dir=./downloads

# 日誌檔目錄 (選填，留空則只輸出到螢幕)
log_dir=./logs

# 記錄檔案原始時間的資料夾
# 用於比對遠端檔案是否更新，每個檔案會產生一個 txt 記錄遠端時間
file_times_dir=./file_times

# ================================================================
# TLS / 連線模式設定
# ================================================================
# 下載程式專用通訊協議設定
# false: 使用 FTP/FTPS（由 use_tls 決定）
# true: 使用 SFTP（SSH File Transfer Protocol，通常 port=22）
use_sftp=false

# SFTP 設定
# use_sftp=true 時使用；ssh_key_path 留空代表使用 pass 密碼登入
# 此設定只影響下載程式，不會影響上傳程式
ssh_key_path=
ssh_host_key_check=false

# 是否啟用 TLS 加密（FTPS）
# use_sftp=false 時使用
# true  = 使用 FTPS（預設，安全）
# false = 使用純文字 FTP（無加密）
use_tls=true

# 是否使用 Implicit TLS (通常使用 port 990)
# 只在 use_tls=true 時有效
use_implicit_tls=false

# 是否跳過 SSL 憑證驗證 (測試環境可設為 true)
# 只在 use_tls=true 時有效
insecure_skip_verify=true

# ================================================================
# 監控模式設定
# ================================================================
# 是否啟用全天候監控模式 (true/false，預設 false)
# - true: 程式持續運行，定期檢查並下載
# - false: 執行一次下載後結束
monitor_mode=false

# 檢查間隔（分鐘，預設 30）
# 監控模式下，每隔多久檢查一次
check_interval=30

# 允許下載的時間範圍（格式：HH:mm-HH:mm）
# 例如 "02:00-05:00" 表示只在凌晨 2-5 點下載
# 支援跨午夜，例如 "22:00-04:00"
# 不設定則任何時間都可下載
#allowed_time_range=02:00-05:00

# 自動停止時間（格式：HH:mm）
# 到達此時間後程式自動關閉
# 適合搭配排程器每天定時啟動和停止
#stop_time=18:00

# ================================================================
# 調試與日誌設定
# ================================================================
# 是否顯示 LIST 命令輸出（檔案清單詳情）
# true: 顯示完整的 FTP LIST 響應（用於調試）
# false: 隱藏 LIST 輸出（預設，避免日誌過於冗長）
debug_list=false

# 是否停用 MLSD，強制使用 LIST（NonStop 伺服器建議 true）
disable_mlsd=true

# 是否為每個下載的檔案建立獨立的日誌
# true: 在 logs/ 目錄下為每個檔案建立 download_<filename>_<timestamp>.log
# false: 所有下載記錄寫入主日誌檔案
separate_file_log=true

# 是否輸出編碼調試資訊
#debug_encoding=false

# ================================================================
# 連線重試設定
# ================================================================
# 連線失敗時的重試次數（預設 3 次）
max_retries=3

# 重試延遲秒數（預設 5 秒）
retry_delay=5

# ================================================================
# 編碼設定 (用於 Guardian/NonStop 等特殊系統)
# ================================================================
# 來源檔案編碼
# 支援: ebcdic, cp037, cp1047, cp1140, big5, utf-8, iso-8859-1
#source_encoding=

# 目標檔案編碼
#target_encoding=

# 跳過檔案開頭的字節數
# - 正數: 跳過指定字節數
# - -1: 過濾控制字元
# - 0: 不處理（推薦）
#skip_header_bytes=0

# Guardian 區塊處理後是否補上 CRLF
#guardian_add_crlf=true

# 原始下載模式（不進行任何處理）
# true: 保持與遠端檔案完全一致
#raw_download=false

# ================================================================
# 檔案下載設定
# ================================================================
# 旗標檔案檢查（結帳檔檢查）
# true: 下載前先檢查指定的旗標檔案是否存在
# false: 不進行旗標檔案檢查，直接下載
# 注意：旗標檔案不存在時，會跳過所有下載作業
#check_flag_file=false
#flag_file_name=DATCLOSE

# 檔案分割設定（針對特定前綴的檔案）
# 會根據每筆資料的前四碼自動分類儲存
#split_file_prefixes=TCD,TSC

# ================================================================
# 智慧下載設定 🆕
# ================================================================
# 下載選項優先級（由高到低）：
# 1. force_download=true → 總是下載，忽略所有檢查
# 2. skip_if_exists=true → 本地檔案存在就跳過
# 3. compare_by_modtime → 比對修改時間或檔案大小
#
# 強制下載所有檔案（忽略本地檔案狀態）
# 注意：此選項優先級最高，會覆蓋 skip_if_exists 設定
# true: 強制下載所有檔案
# false: 依照 skip_if_exists 設定決定
#force_download=false

# 是否啟用智慧下載（檢查本地檔案，只下載不存在或較新的檔案）
# true: 啟用智慧下載，本地檔案存在就跳過（不比對內容）
# false: 每次都重新下載所有檔案（預設）
skip_if_exists=false

# 比對方式選擇（僅當 skip_if_exists=false 且 force_download=false 時生效）
# true: 使用修改時間比對（需要伺服器支援 MDTM 或 LIST 命令）
#       - 無法取得時間時會強制下載以確保完整性
# false: 使用檔案大小比對（相容性較好，適合大多數場景）
#        - 無法取得大小時會強制下載以確保完整性
compare_by_modtime=true

# ================================================================
# 下載檔案清單
# ================================================================
# 若無指定則下載當前目錄所有檔案
#
# 支援多種方式：
# 1. files: 明確指定檔案
#    file_names.0.files.0=檔名
#    file_names.0.files.1=遠端檔名:本地檔名
#
# 2. patterns: 萬用字元匹配
#    file_names.0.patterns.0=*.txt
#    file_names.0.patterns.1=TCD*
#
# 3. include_prefixes: 前綴篩選
#    file_names.0.include_prefixes.0=TCD
#
# 4. include_suffixes: 後綴篩選
#    file_names.0.include_suffixes.0=.5920
#
# 5. exclude_files: 排除檔案
#    file_names.0.exclude_files.0=test.txt
#
# ================================================================

# 範例 1: 基本檔案下載
file_names.0.remote_path=\\CSTP96.$DATA.SKDATA91
file_names.0.files.0=RYM01
file_names.0.files.1=RYM02

# 範例 2: 使用時間範圍和前綴篩選
#file_names.1.remote_path=\\CSTP96.$DATA.SKDATA91
#file_names.1.allowed_time_range=02:00-05:00
#file_names.1.include_prefixes.0=TCD
#file_names.1.include_prefixes.1=TSC

# 範例 3: 使用萬用字元和後綴篩選
#file_names.2.remote_path=\\CSTP96.$DATA.SKDATA91
#file_names.2.patterns.0=*.5920
#file_names.2.include_suffixes.0=.5920

# 範例 4: 排除特定檔案
#file_names.3.remote_path=\\CSTP96.$DATA.SKDATA91
#file_names.3.exclude_files.0=test
#file_names.3.exclude_files.1=backup

# ================================================================
# 使用說明
# ================================================================
# 
# 【一般使用】
# 1. 複製此檔案為 config.properties
# 2. 修改連線設定 (host, user, pass)
# 3. 設定下載目錄和檔案清單
# 4. 執行: ftps-downloader.exe
#
# 【監控模式】
# 1. 設定 monitor_mode=true
# 2. 設定 check_interval 和 allowed_time_range
# 3. 背景執行: run_ftps_downloader_hidden.vbs
#
# 【自動停止】
# 1. 設定 stop_time=18:00
# 2. 搭配排程器每天定時啟動
# 3. 程式會在設定時間自動停止
#
# 詳細說明請參考:
# - README.md
# - MONITOR_MODE_GUIDE.md
# - AUTO_STOP_GUIDE.md
# ================================================================
