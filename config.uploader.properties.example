# FTPS Uploader 設定檔範例

# FTPS 伺服器設定
host=192.168.27.22
port=8421
user=MLS.OP200
pass=CMAKE#96

# 上傳程式專用通訊協議設定
# false: 使用 FTP/FTPS（預設）
# true: 使用 SFTP（SSH File Transfer Protocol，通常 port=22）
use_sftp=false

# 目錄設定
# 遠端上傳目錄 (選填)
remote_dir=
# 本地讀取目錄
local_dir=./uploads
# 日誌檔目錄
log_dir=./logs

# TLS 設定
# use_sftp=false 時使用；此設定只影響上傳程式
# true  = 使用 FTPS
# false = 使用純文字 FTP
use_tls=true
use_implicit_tls=false
insecure_skip_verify=true

# SFTP 設定
# use_sftp=true 時使用；ssh_key_path 留空代表使用 pass 密碼登入
# 此設定只影響上傳程式，不會影響下載程式
#ssh_key_path=
#ssh_host_key_check=false

# 上傳時間限制 (選填)
# 格式: HH:mm-HH:mm
# 只有在指定時間範圍內才會執行上傳，否則會直接結束
#allowed_time_range=02:00-05:00

# ========================================
# 檔案上傳規則說明
# ========================================
# 支援多種方式指定要上傳的檔案：
#
# 1. files: 明確指定檔案名稱
#    格式: file_names.索引.files.編號=本地檔名[:遠端檔名]
#    範例: file_names.0.files.0=RYM01
#          file_names.0.files.1=RYM02:RYM02_RENAMED
#
# 2. patterns: 使用萬用字元匹配檔案
#    格式: file_names.索引.patterns.編號=萬用字元模式
#    範例: file_names.0.patterns.0=*.txt      (所有 .txt 檔案)
#          file_names.0.patterns.1=TCD*       (TCD 開頭的檔案)
#          file_names.0.patterns.2=RYM??      (RYM 後接兩個字元)
#
# 3. include_prefixes: 只上傳符合前綴的檔案
#    格式: file_names.索引.include_prefixes.編號=前綴
#    範例: file_names.0.include_prefixes.0=TCD
#          file_names.0.include_prefixes.1=TSC
#
# 4. include_suffixes: 只上傳符合後綴的檔案
#    格式: file_names.索引.include_suffixes.編號=後綴
#    範例: file_names.0.include_suffixes.0=.txt
#          file_names.0.include_suffixes.1=.dat
#
# 5. exclude_files: 排除特定檔案
#    格式: file_names.索引.exclude_files.編號=檔案名稱
#    範例: file_names.0.exclude_files.0=test.txt
#          file_names.0.exclude_files.1=backup.dat
#
# 注意事項：
# - 可以同時使用多種規則，系統會自動合併結果
# - 排除規則優先級最高（exclude_files）
# - 前綴和後綴規則可以組合使用（必須同時符合）
# - 萬用字元支援: * (多個字元), ? (單一字元)
# ========================================

# 範例 1: 明確指定檔案
file_names.0.local_path=./downloads
file_names.0.files.0=RYM01
file_names.0.files.1=RYM02:RYM02_UPLOADED

# 範例 2: 使用萬用字元上傳所有 TCD 和 TSC 開頭的檔案
#file_names.1.local_path=./downloads
#file_names.1.patterns.0=TCD*
#file_names.1.patterns.1=TSC*

# 範例 3: 只上傳 .txt 檔案
#file_names.2.local_path=./downloads
#file_names.2.patterns.0=*.txt

# 範例 4: 使用前綴篩選（自動掃描目錄，只上傳符合前綴的檔案）
#file_names.3.local_path=./downloads
#file_names.3.include_prefixes.0=TCD
#file_names.3.include_prefixes.1=TSC
#file_names.3.include_suffixes.0=.5920  # 可選：同時限制後綴

# 範例 5: 上傳所有檔案，但排除特定檔案
#file_names.4.local_path=./downloads
#file_names.4.patterns.0=*
#file_names.4.exclude_files.0=test.txt
#file_names.4.exclude_files.1=backup.dat

# 範例 6: 組合使用（只上傳 TCD 開頭且為 .txt 的檔案，但排除 TCD_TEST.txt）
#file_names.5.local_path=./downloads
#file_names.5.include_prefixes.0=TCD
#file_names.5.include_suffixes.0=.txt
#file_names.5.exclude_files.0=TCD_TEST.txt
